# FitCV local Docker/runtime environment (public-safe example)
# Copy to .env locally and fill secrets.
#
# SSOT rule:
# - Default routing owner is config/runtime/control_plane.yaml
# - FITCV_LANGGRAPH_* vars are optional override-only

# Required secret for OpenAI-compatible calls
OPENAI_API_KEY=your_openai_api_key_here

# Optional override-only routing vars (set only when you need override)
# FITCV_LANGGRAPH_PROVIDER=9router
# FITCV_LANGGRAPH_WIRE_API=responses
# FITCV_LANGGRAPH_MODEL=cx/gpt-5.2
# FITCV_LANGGRAPH_OPENAI_BASE_URL=http://host.docker.internal:20128/v1
# FITCV_CP_OPENAI_COMPATIBLE_BASE_URL=http://localhost:20128/v1

# Optional compose interpolation overrides
# GCP_PROJECT=fitcv-491123
# BIGQUERY_DATASET=fitcv
# GCP_SA_KEY_PATH=C:\secure\your-service-account.json
# FITCV_LANGGRAPH_REPO_PATH=C:\path\to\fitcv-langgraph
