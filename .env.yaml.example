# Public-safe runtime configuration template for local FitCV runs
# Copy this file to `.env.yaml` and fill values for your environment.

gcp_project: "your-gcp-project-id"
bigquery_dataset: "fitcv"
service_account_key: "sa_key.json"
embedding_model: "text-embedding-005"
gemini_model: "gemini-2.5-flash"
ai_score_model: "gemini-2.5-flash"
location: "us-central1"
enrichment_sleep_secs: 3
enrichment_max_retries: 3
# Apify source (optional)
apify_dataset_id: ""
apify_token: ""
